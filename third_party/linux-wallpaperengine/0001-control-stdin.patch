diff --git a/src/WallpaperEngine/Input/ExternalControl.cpp b/src/WallpaperEngine/Input/ExternalControl.cpp
new file mode 100644
index 0000000..60170c6
--- /dev/null
+++ b/src/WallpaperEngine/Input/ExternalControl.cpp
@@ -0,0 +1,79 @@
+#include "ExternalControl.h"
+
+#include <atomic>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <thread>
+
+using namespace WallpaperEngine::Input;
+
+namespace {
+std::atomic<bool> s_enabled = false;
+std::atomic<bool> s_paused = false;
+std::atomic<bool> s_quit = false;
+std::atomic<double> s_x = 0.0;
+std::atomic<double> s_y = 0.0;
+std::atomic<bool> s_left = false;
+std::atomic<bool> s_right = false;
+
+void readLoop () {
+    std::string line;
+
+    while (std::getline (std::cin, line)) {
+	std::istringstream in (line);
+	char cmd = 0;
+	in >> cmd;
+
+	switch (cmd) {
+	    case 'm': {
+		double x, y;
+		if (in >> x >> y) {
+		    s_x = x;
+		    s_y = y;
+		}
+		break;
+	    }
+	    case 'b': {
+		char which = 0;
+		int down = 0;
+		if (in >> which >> down) {
+		    (which == 'r' ? s_right : s_left) = down != 0;
+		}
+		break;
+	    }
+	    case 'p': {
+		int paused = 0;
+		if (in >> paused) {
+		    s_paused = paused != 0;
+		}
+		break;
+	    }
+	    case 'q': s_quit = true; return;
+	    default: break;
+	}
+    }
+
+    s_quit = true;
+}
+} // namespace
+
+void ExternalControl::start () {
+    if (s_enabled.exchange (true)) {
+	return;
+    }
+
+    std::thread (readLoop).detach ();
+}
+
+bool ExternalControl::enabled () { return s_enabled; }
+
+bool ExternalControl::paused () { return s_paused; }
+
+bool ExternalControl::quitRequested () { return s_quit; }
+
+glm::dvec2 ExternalControl::position () { return { s_x.load (), s_y.load () }; }
+
+bool ExternalControl::leftDown () { return s_left; }
+
+bool ExternalControl::rightDown () { return s_right; }
diff --git a/src/WallpaperEngine/Input/ExternalControl.h b/src/WallpaperEngine/Input/ExternalControl.h
new file mode 100644
index 0000000..79f57e9
--- /dev/null
+++ b/src/WallpaperEngine/Input/ExternalControl.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <glm/vec2.hpp>
+
+namespace WallpaperEngine::Input {
+/**
+ * Optional control channel on stdin (--control-stdin) for hosts that show the
+ * window somewhere it never receives real input, e.g. a GNOME Shell extension
+ * cloning it into the desktop background. One command per line:
+ *
+ *   m <x> <y>       pointer position in window coordinates (top-left origin)
+ *   b <l|r> <0|1>   button released/pressed
+ *   p <0|1>         resume/pause rendering
+ *   q               quit (EOF on stdin quits too, so the host dying never leaves orphans)
+ */
+class ExternalControl {
+public:
+    /** Starts the reader thread; called once when --control-stdin is given */
+    static void start ();
+    [[nodiscard]] static bool enabled ();
+    [[nodiscard]] static bool paused ();
+    [[nodiscard]] static bool quitRequested ();
+    /** Last pointer position in window coordinates (top-left origin) */
+    [[nodiscard]] static glm::dvec2 position ();
+    [[nodiscard]] static bool leftDown ();
+    [[nodiscard]] static bool rightDown ();
+};
+} // namespace WallpaperEngine::Input
