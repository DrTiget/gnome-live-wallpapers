From 52e769cd3fe57971f44384474e8a0eac8779f489 Mon Sep 17 00:00:00 2001
From: WPE <wpe@localhost>
Date: Tue, 20 Oct 2026 20:21:25 +0200
Subject: [PATCH] Exit right away on fatal errors instead of hanging in
 destructors

A wallpaper that fails to load (bad scene.json, unsupported scene) printed the
exception and returned from main, but static destructors (CEF, audio threads)
could hang, leaving a process without a window that the host cannot tell from
a working one. Flush and _Exit(1) instead.
---
 src/main.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/main.cpp b/src/main.cpp
index 908ab69..3bf0c74 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 #include <csignal>
 #include <iostream>
 
@@ -73,6 +74,9 @@ int main (int argc, char* argv[]) {
 	return 0;
     } catch (const std::exception& e) {
 	std::cerr << e.what () << std::endl;
-	return 1;
+	// a normal return runs static destructors (CEF, audio threads) that can hang after a
+	// half-done start, leaving a process without a window: exit right away instead
+	std::cout.flush ();
+	std::_Exit (1);
     }
 }
\ No newline at end of file
